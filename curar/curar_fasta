from Bio import SeqIO
from Bio.Seq import Seq
import pandas as pd
import sys
import os

# ================= FUNÇÕES DE CURAÇÃO =================

def encontrar_start(seq):
    return seq.find("ATG")

def encontrar_stop(seq, inicio):
    stops = {"TAA", "TAG", "TGA"}
    for i in range(inicio, len(seq) - 2, 3):
        if seq[i:i+3] in stops:
            return i
    return -1

def curar_sequencia(seq):
    inicio = encontrar_start(seq)
    if inicio == -1:
        return None

    inicio_stop = encontrar_stop(seq, inicio)
    if inicio_stop == -1:
        return None

    cds = seq[inicio:inicio_stop + 3]

    if len(cds) % 3 != 0:
        return None

    return cds

# ================= MAIN =================

if __name__ == "__main__":

    if len(sys.argv) < 2:
        print("Uso: python curar_fasta.py <arquivo_fasta>")
        sys.exit(1)

    arquivo_fasta = sys.argv[1]

    nome_base = os.path.splitext(os.path.basename(arquivo_fasta))[0]
    pasta_saida = "saida_curacao"
    os.makedirs(pasta_saida, exist_ok=True)

    arquivo_curado = os.path.join(pasta_saida, nome_base + "_curadas.fasta")
    arquivo_xls = os.path.join(pasta_saida, nome_base + "_curacao.xlsx")

    registros = list(SeqIO.parse(arquivo_fasta, "fasta"))

    curadas = []
    relatorio = []

    for record in registros:
        seq_original = str(record.seq).upper().replace("-", "")
        seq_curada = curar_sequencia(seq_original)

        if seq_curada:
            record.seq = Seq(seq_curada)
            curadas.append(record)

        relatorio.append({
            "id": record.id,
            "comprimento_original": len(seq_original),
            "curada": "SIM" if seq_curada else "NAO",
            "comprimento_curado": len(seq_curada) if seq_curada else 0
        })

    # Salvar FASTA
    SeqIO.write(curadas, arquivo_curado, "fasta")

    # Salvar XLS
    df = pd.DataFrame(relatorio)
    df.to_excel(arquivo_xls, index=False)

    print(f"Total de sequências: {len(registros)}")
    print(f"Sequências curadas: {len(curadas)}")
    print(f"FASTA curado: {arquivo_curado}")
    print(f"Relatório XLS: {arquivo_xls}")
